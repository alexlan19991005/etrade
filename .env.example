# E*TRADE API credentials — copy to `.env` and fill in. NEVER commit `.env`.
# Get keys at https://developer.etrade.com (free developer account).
# Start in the sandbox; only switch ETRADE_ENV=production when you are ready
# to trade real money, and only after testing in the sandbox.

# sandbox | production  (default: sandbox)
ETRADE_ENV=sandbox

# Production (live) API keys from developer.etrade.com
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=

# Sandbox API keys (separate keys issued for the sandbox environment)
ETRADE_SANDBOX_KEY=
ETRADE_SANDBOX_SECRET=
